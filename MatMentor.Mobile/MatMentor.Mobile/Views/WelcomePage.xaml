<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MatMentor.Mobile.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:MatMentor.Mobile.ViewModels"
    x:DataType="viewModels:WelcomeViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8F3E7">

    <Grid>

        <!-- Full-screen hero illustration -->
        <Image
            Source="welcome_hero.png"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!-- Soft bottom overlay -->
        <BoxView
            VerticalOptions="End"
            HeightRequest="180">

            <BoxView.Background>
                <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="0,1">

                    <GradientStop
                        Color="#00FFF8E8"
                        Offset="0.0" />

                    <GradientStop
                        Color="#C8FFF8E8"
                        Offset="0.55" />

                    <GradientStop
                        Color="#F8FFF8E8"
                        Offset="1.0" />

                </LinearGradientBrush>
            </BoxView.Background>

        </BoxView>

        <!-- Welcome actions -->
        <VerticalStackLayout
            VerticalOptions="End"
            Padding="24,0,24,28"
            Spacing="12">

            <!-- Login button -->
            <Button
                Text="Log ind  →"
                Command="{Binding LoginCommand}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                FontSize="19"
                FontAttributes="Bold"
                HeightRequest="58"
                CornerRadius="25" />

            <!-- Create profile action -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="5">

                <Label
                    Text="Har du ikke en profil?"
                    FontSize="15"
                    TextColor="#5E6275"
                    VerticalOptions="Center" />

                <Label
                    Text="Opret profil"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Primary}"
                    VerticalOptions="Center">

                    <Label.GestureRecognizers>

                        <TapGestureRecognizer
                            Command="{Binding CreateProfileCommand}" />

                    </Label.GestureRecognizers>

                </Label>

            </HorizontalStackLayout>

        </VerticalStackLayout>

    </Grid>

</ContentPage>