<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MatMentor.Mobile.Views.StartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:MatMentor.Mobile.ViewModels"
    x:DataType="viewModels:StartViewModel"
    Title="Start"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F7F2E7">

    <Grid>

        <!-- Full-screen landscape background -->
        <Image
            Source="start_background.png"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!-- Soft top overlay -->
        <BoxView
            VerticalOptions="Start"
            HeightRequest="250">

            <BoxView.Background>
                <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="0,1">

                    <GradientStop
                        Color="#C8FFFFFF"
                        Offset="0.0" />

                    <GradientStop
                        Color="#00FFFFFF"
                        Offset="1.0" />

                </LinearGradientBrush>
            </BoxView.Background>

        </BoxView>

        <!-- Soft bottom overlay -->
        <BoxView
            VerticalOptions="End"
            HeightRequest="190">

            <BoxView.Background>
                <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="0,1">

                    <GradientStop
                        Color="#00FFF8E8"
                        Offset="0.0" />

                    <GradientStop
                        Color="#E8FFF8E8"
                        Offset="1.0" />

                </LinearGradientBrush>
            </BoxView.Background>

        </BoxView>

        <!-- Main content -->
        <ScrollView>

            <VerticalStackLayout
                Padding="24,58,24,28"
                Spacing="18">

                <!-- Page heading -->
                <VerticalStackLayout
                    Spacing="4"
                    Margin="0,0,0,8">

                    <Label
                        Text="Hej der!"
                        FontSize="36"
                        FontAttributes="Bold"
                        TextColor="#17213C"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Hvad vil du lave i dag?"
                        FontSize="17"
                        TextColor="#49526F"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

                <!-- Practice card -->
                <Border
                    BackgroundColor="#DCF28B"
                    Stroke="#7E9F3B"
                    StrokeThickness="2"
                    Padding="20"
                    HeightRequest="190">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#55000000"
                            Offset="0,5"
                            Radius="10"
                            Opacity="0.25" />
                    </Border.Shadow>

                    <Border.GestureRecognizers>

                        <TapGestureRecognizer
                            Command="{Binding PracticeCommand}" />

                    </Border.GestureRecognizers>

                    <Grid
                        ColumnDefinitions="*,135"
                        ColumnSpacing="8">

                        <!-- Practice text -->
                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="7"
                            VerticalOptions="Center">

                            <Label
                                Text="Øv dig"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="#26380F" />

                            <Label
                                Text="Træn med øvesæt og bliv stærkere"
                                FontSize="16"
                                TextColor="#40551E"
                                LineHeight="1.2" />

                            <Label
                                Text="→"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="#40551E"
                                Margin="0,5,0,0" />

                        </VerticalStackLayout>

                        <!-- Practice illustration -->
                        <Image
                            Grid.Column="1"
                            Source="start_practice_student.png"
                            WidthRequest="135"
                            HeightRequest="150"
                            Aspect="AspectFit"
                            HorizontalOptions="End"
                            VerticalOptions="End" />

                    </Grid>

                </Border>

                <!-- Tutor card -->
                <Border
                    BackgroundColor="#D4C4FF"
                    Stroke="#8267D7"
                    StrokeThickness="2"
                    Padding="20"
                    HeightRequest="190">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#55000000"
                            Offset="0,5"
                            Radius="10"
                            Opacity="0.25" />
                    </Border.Shadow>

                    <Border.GestureRecognizers>

                        <TapGestureRecognizer
                            Command="{Binding TutorCommand}" />

                    </Border.GestureRecognizers>

                    <Grid
                        ColumnDefinitions="*,135"
                        ColumnSpacing="8">

                        <!-- Tutor text -->
                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="7"
                            VerticalOptions="Center">

                            <Label
                                Text="Få hjælp til lektier"
                                FontSize="25"
                                FontAttributes="Bold"
                                TextColor="#30225A"
                                LineBreakMode="WordWrap" />

                            <Label
                                Text="Stil spørgsmål til din AI-tutor"
                                FontSize="16"
                                TextColor="#59478E"
                                LineHeight="1.2" />

                            <Label
                                Text="→"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="#59478E"
                                Margin="0,5,0,0" />

                        </VerticalStackLayout>

                        <!-- Tutor illustration -->
                        <Image
                            Grid.Column="1"
                            Source="start_tutor_robot.png"
                            WidthRequest="130"
                            HeightRequest="140"
                            Aspect="AspectFit"
                            HorizontalOptions="End"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

                <!-- Spacer -->
                <Grid HeightRequest="110" />

                <!-- Logout button -->
                <Button
                    Text="Log ud"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="#F9F4EA"
                    TextColor="#6E7393"
                    BorderColor="#D9D0BE"
                    BorderWidth="1"
                    CornerRadius="18"
                    FontSize="15"
                    HeightRequest="50" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>