<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MatMentor.Mobile.Views.ExerciseSetPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MatMentor.Mobile.ViewModels"
             x:DataType="viewModels:ExerciseSetViewModel"
             Title="Øvesæt" BackgroundColor="#F8FAFF">
    <ScrollView>
        <VerticalStackLayout Padding="22,34,22,32" Spacing="22">
            <Label Text="Klar til at øve?" FontSize="35" FontAttributes="Bold" TextColor="#0E1B4D" />
            <Label Text="Her er dit næste øvesæt." FontSize="18" TextColor="#6B7995" />
            <Border BackgroundColor="#F2F3EE" StrokeThickness="0" Padding="24" Margin="0,12,0,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="27" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="DIT EMNE" FontSize="13" FontAttributes="Bold" TextColor="#58665E" />
                    <Label Text="{Binding TopicName}" FontSize="29" FontAttributes="Bold"
                           TextColor="#0E1B4D" LineBreakMode="WordWrap" />
                    <Label Text="Du får fem opgaver inden for dette emne." FontSize="16"
                           TextColor="#586D8F" LineHeight="1.25" />
                </VerticalStackLayout>
            </Border>
            <Border BackgroundColor="White" Stroke="#DCE2D9" StrokeThickness="1"
                    Padding="19" Margin="0,5,0,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                <Grid ColumnDefinitions="48,*" ColumnSpacing="14">
                    <Border Grid.Column="0" BackgroundColor="#FFF1D5" StrokeThickness="0"
                            HeightRequest="45" WidthRequest="45" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
                        <Label Text="★" TextColor="#F5A214" FontSize="23"
                               VerticalOptions="Center" HorizontalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="Tag én opgave ad gangen" FontSize="16" FontAttributes="Bold"
                               TextColor="#0E1B4D" />
                        <Label Text="Du behøver ikke skynde dig." FontSize="14" TextColor="#63728F" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
            <Label Text="Din mission bliver vist, før du går i gang." FontSize="14"
                   TextColor="#63728F" HorizontalTextAlignment="Center" Margin="0,4,0,0" />
            <ActivityIndicator IsRunning="{Binding IsStarting}" IsVisible="{Binding IsStarting}" Color="#58665E" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" FontSize="14" />
            <Button Text="Start øvesæt" Command="{Binding StartExerciseSetCommand}"
                    IsEnabled="{Binding CanStart}" BackgroundColor="#58665E"
                    TextColor="White" FontSize="18" CornerRadius="23" MinimumHeightRequest="56"
                    Margin="0,6,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
