<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MatMentor.Mobile.Views.ExercisePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:MatMentor.Mobile.ViewModels"
    x:DataType="viewModels:ExerciseViewModel"
    Title="Opgave">

    <ScrollView>
        <VerticalStackLayout
            Padding="32"
            Spacing="24">

            <Label
                Text="{Binding TopicName}"
                FontSize="16"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding ExercisePositionText}"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding ExerciseText}"
                FontSize="20" />

            <Label
                Text="Dit svar" />

            <Entry
                Placeholder="Skriv dit svar"
                Text="{Binding SubmittedAnswer}" />

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red"
                FontSize="14" />

            <Button
                Text="{Binding NextButtonText}"
                Command="{Binding NextExerciseCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>