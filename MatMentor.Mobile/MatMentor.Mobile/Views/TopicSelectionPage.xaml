<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MatMentor.Mobile.Views.TopicSelectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:MatMentor.Mobile.ViewModels"
    x:DataType="viewModels:TopicSelectionViewModel"
    Title="Vælg emne"
    BackgroundColor="#F7F7FC">

    <ScrollView>

        <VerticalStackLayout
            Padding="28,34,28,34"
            Spacing="20">

            <!-- Page heading -->
            <VerticalStackLayout
                Spacing="8"
                Margin="0,0,0,12">

                <Label
                    Text="Hvad vil du øve?"
                    FontFamily="OpenSansSemibold"
                    FontSize="31"
                    TextColor="#0E1B4D"
                    LineBreakMode="NoWrap" />

                <Label
                    Text="Vælg et matematikemne."
                    FontFamily="OpenSansRegular"
                    FontSize="17"
                    TextColor="#777E9B" />

            </VerticalStackLayout>

            <!-- Fraction, decimal and percent -->
            <Border
                BackgroundColor="#F1ECFF"
                StrokeThickness="0"
                HeightRequest="190"
                Padding="22,20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow
                        Brush="#18000000"
                        Offset="0,4"
                        Radius="10"
                        Opacity="0.20" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding SelectTopicCommand}"
                        CommandParameter="Brøk, decimaltal og procent" />
                </Border.GestureRecognizers>

                <Grid
                    ColumnDefinitions="1.25*,0.75*"
                    ColumnSpacing="10">

                    <!-- Text -->
                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="10"
                        VerticalOptions="Center">

                        <Label
                            Text="Brøk, decimaltal&#10;og procent"
                            FontFamily="OpenSansSemibold"
                            FontSize="25"
                            TextColor="#0E1B4D"
                            LineHeight="1.05"
                            LineBreakMode="NoWrap" />

                        <Label
                            Text="Øv med opgaver om brøker, decimaltal og procent."
                            FontFamily="OpenSansRegular"
                            FontSize="15"
                            TextColor="#777E9B"
                            LineHeight="1.25"
                            LineBreakMode="WordWrap"
                            MaxLines="3" />

                    </VerticalStackLayout>

                    <!-- Illustration and arrow -->
                    <Grid
                        Grid.Column="1">

                        <Image
                            Source="topic_fraction_decimal_percent.png"
                            WidthRequest="145"
                            HeightRequest="145"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                        <Border
                            WidthRequest="48"
                            HeightRequest="48"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>

                            <Label
                                Text="›"
                                FontFamily="OpenSansSemibold"
                                FontSize="28"
                                TextColor="#0E1B4D"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Margin="0,-3,0,0" />

                        </Border>

                    </Grid>

                </Grid>

            </Border>

            <!-- Commercial arithmetic -->
            <Border
                BackgroundColor="#FFF0D1"
                StrokeThickness="0"
                HeightRequest="190"
                Padding="22,20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow
                        Brush="#18000000"
                        Offset="0,4"
                        Radius="10"
                        Opacity="0.20" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding SelectTopicCommand}"
                        CommandParameter="Handelsregning" />
                </Border.GestureRecognizers>

                <Grid
                    ColumnDefinitions="1.25*,0.75*"
                    ColumnSpacing="10">

                    <!-- Text -->
                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="10"
                        VerticalOptions="Center">

                        <Label
                            Text="Handelsregning"
                            FontFamily="OpenSansSemibold"
                            FontSize="24"
                            TextColor="#0E1B4D"
                            LineBreakMode="NoWrap"
                            MaxLines="1" />

                        <Label
                            Text="Øv med opgaver om rabat, moms, pris og penge."
                            FontFamily="OpenSansRegular"
                            FontSize="15"
                            TextColor="#777E9B"
                            LineHeight="1.25"
                            LineBreakMode="WordWrap"
                            MaxLines="3" />

                    </VerticalStackLayout>

                    <!-- Illustration and arrow -->
                    <Grid
                        Grid.Column="1">

                        <Image
                            Source="topic_commercial_arithmetic.png"
                            WidthRequest="145"
                            HeightRequest="145"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                        <Border
                            WidthRequest="48"
                            HeightRequest="48"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>

                            <Label
                                Text="›"
                                FontFamily="OpenSansSemibold"
                                FontSize="28"
                                TextColor="#0E1B4D"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Margin="0,-3,0,0" />

                        </Border>

                    </Grid>

                </Grid>

            </Border>

            <!-- Time -->
            <Border
                BackgroundColor="#E8F2FF"
                StrokeThickness="0"
                HeightRequest="190"
                Padding="22,20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow
                        Brush="#18000000"
                        Offset="0,4"
                        Radius="10"
                        Opacity="0.20" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding SelectTopicCommand}"
                        CommandParameter="Tid" />
                </Border.GestureRecognizers>

                <Grid
                    ColumnDefinitions="1.25*,0.75*"
                    ColumnSpacing="10">

                    <!-- Text -->
                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="10"
                        VerticalOptions="Center">

                        <Label
                            Text="Tid"
                            FontFamily="OpenSansSemibold"
                            FontSize="25"
                            TextColor="#0E1B4D"
                            LineBreakMode="NoWrap" />

                        <Label
                            Text="Øv med opgaver om klokkeslæt, tidsrum og omregning af tid."
                            FontFamily="OpenSansRegular"
                            FontSize="15"
                            TextColor="#777E9B"
                            LineHeight="1.25"
                            LineBreakMode="WordWrap"
                            MaxLines="3" />

                    </VerticalStackLayout>

                    <!-- Illustration and arrow -->
                    <Grid
                        Grid.Column="1">

                        <Image
                            Source="topic_time.png"
                            WidthRequest="145"
                            HeightRequest="145"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                        <Border
                            WidthRequest="48"
                            HeightRequest="48"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>

                            <Label
                                Text="›"
                                FontFamily="OpenSansSemibold"
                                FontSize="28"
                                TextColor="#0E1B4D"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Margin="0,-3,0,0" />

                        </Border>

                    </Grid>

                </Grid>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>